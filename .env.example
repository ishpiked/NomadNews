# Bot Configuration
# Get your bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Your Telegram user ID (get from @userinfobot)
OWNER_ID=

# Optional: Custom config/database paths
CONFIG_FILE=config.json
DB_FILE=news.db

# Optional: Log file path (leave empty for stdout only)
LOG_FILE=bot.log

# Optional: Number of max channels (default 4)
MAX_CHANNELS=4

# Optional: Posting interval in minutes (default 30)
DEFAULT_INTERVAL_MINUTES=30